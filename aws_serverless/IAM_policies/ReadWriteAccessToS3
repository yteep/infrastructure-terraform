{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowBucketAccess",
            "Effect": "Allow",
            "Action": [
                "s3:Get*",
                "s3:CreateBucket",
                "s3:PutObject",
                "s3:PutBucketTagging",
                "s3:ListBucket",
                "s3:DeleteObject",
                "s3:DeleteBucket",
                "s3:ListBucketVersions",
                "s3:ListAllMyBuckets",
                "s3:DeleteObjectVersion"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DenyDeleteBackendBucket",
            "Effect": "Deny",
            "Action": [
                "s3:DeleteBucket"
            ],
            "Resource": "arn:aws:s3:::tf-infra-state-jtlnc45"
        }
    ]
}