{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ManageIamRoles",
            "Effect": "Allow",
            "Action": [
                "iam:List*",
                "iam:Get*",
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:AttachRolePolicy",
                "iam:DetachRolePolicy",
                "iam:TagRole"
            ],
            "Resource": "*"
        }
    ]
}